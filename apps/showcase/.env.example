# The Collective Style Guide Library — showcase env
# Copy to `.env.local` (gitignored) and fill in values.
# Local dev does not require any of these.

# ─── Vercel (deploy) ─────────────────────────────────────────────
# Used by `vercel` CLI for deploys. Generate at vercel.com/account/tokens.
VERCEL_TOKEN=

# ─── Adobe Fonts (optional) ──────────────────────────────────────
# Adobe Fonts (Typekit) loads from a public kit ID exposed in the URL,
# so the kit ID itself is not a secret. The default kit is wired into
# every variant's theme.ts. Override here only if you want a different
# kit project-wide (rare — most consumers swap providers per variant).
NEXT_PUBLIC_ADOBE_FONTS_KIT_ID=mru0igx

# ─── Anthropic (reserved) ────────────────────────────────────────
# Reserved for future in-product AI features (e.g. live "explain this
# token" assistant). Not currently consumed.
ANTHROPIC_API_KEY=

# ─── Auth0 (reserved) ────────────────────────────────────────────
# Reserved for future gated areas of the showcase. Not currently consumed.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
