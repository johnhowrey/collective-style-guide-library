{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Marginalia — Penguin Books-inspired tokens. Part of The Collective Style Guide Library.",
  "$version": "0.0.0",
  "color": {
    "light": {
      "background": { "$value": "#F4ECD8", "$type": "color", "$description": "Cream paper", "$extensions": { "collective.contrast": { "vs": "#1A1612", "ratio": 14.6, "wcag": "AAA" } } },
      "surface": { "$value": "#F8F1DF", "$type": "color" },
      "surfaceSecondary": { "$value": "#EAE0C7", "$type": "color" },
      "text": { "$value": "#1A1612", "$type": "color" },
      "textSecondary": { "$value": "#5A4F45", "$type": "color" },
      "border": { "$value": "#C9BFA8", "$type": "color" },
      "accent": { "primary": { "$value": "#E96528", "$type": "color", "$description": "Penguin orange" } },
      "focus": { "$value": "#E96528", "$type": "color" }
    },
    "dark": {
      "background": { "$value": "#1A1612", "$type": "color" },
      "surface": { "$value": "#26201A", "$type": "color" },
      "surfaceSecondary": { "$value": "#332B22", "$type": "color" },
      "text": { "$value": "#F4ECD8", "$type": "color" },
      "textSecondary": { "$value": "#B8AC93", "$type": "color" },
      "border": { "$value": "#3D352B", "$type": "color" },
      "accent": { "primary": { "$value": "#FF8854", "$type": "color" } },
      "focus": { "$value": "#FF8854", "$type": "color" }
    }
  },
  "typography": {
    "family": {
      "serif": { "$value": "bembo-book, 'Adobe Garamond Pro', 'ITC New Baskerville', 'Hoefler Text', Georgia, serif", "$type": "fontFamily", "$description": "Body copy" },
      "sans": { "$value": "gill-sans-nova, 'Gill Sans', 'Helvetica Neue', helvetica, sans-serif", "$type": "fontFamily", "$description": "Chrome/UI" },
      "display": { "$value": "gill-sans-nova, 'Gill Sans', 'Helvetica Neue', sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "ibm-plex-mono, 'JetBrains Mono', monospace", "$type": "fontFamily" }
    }
  },
  "radius": {
    "sm": { "$value": "0", "$type": "dimension" },
    "md": { "$value": "0", "$type": "dimension" },
    "lg": { "$value": "0", "$type": "dimension" }
  },
  "density": {
    "comfortable": { "spacingStep": { "$value": "8px", "$type": "dimension" }, "controlHeight": { "$value": "40px", "$type": "dimension" } },
    "compact": { "spacingStep": { "$value": "6px", "$type": "dimension" }, "controlHeight": { "$value": "34px", "$type": "dimension" } }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "200ms", "$type": "duration" },
      "standard": { "$value": "320ms", "$type": "duration" },
      "slow": { "$value": "480ms", "$type": "duration" }
    },
    "easing": { "standard": { "$value": "cubic-bezier(0.45, 0, 0.55, 1)", "$type": "cubicBezier", "$description": "Ease-in-out, page-turn rhythm" } }
  }
}
