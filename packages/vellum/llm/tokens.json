{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Vellum — International Style tokens. Part of The Collective Style Guide Library.",
  "$version": "0.0.0",
  "color": {
    "light": {
      "background": { "$value": "#F8F7F4", "$type": "color", "$extensions": { "collective.contrast": { "vs": "#1A1A1A", "ratio": 16.1, "wcag": "AAA" } } },
      "surface": { "$value": "#FFFFFF", "$type": "color" },
      "surfaceSecondary": { "$value": "#ECEAE5", "$type": "color" },
      "text": { "$value": "#1A1A1A", "$type": "color" },
      "textSecondary": { "$value": "#6B6B6B", "$type": "color" },
      "border": { "$value": "#D6D3CC", "$type": "color" },
      "accent": { "primary": { "$value": "#B8442C", "$type": "color", "$description": "Terracotta — the single accent" } },
      "focus": { "$value": "#B8442C", "$type": "color" }
    },
    "dark": {
      "background": { "$value": "#1A1817", "$type": "color" },
      "surface": { "$value": "#26221F", "$type": "color" },
      "surfaceSecondary": { "$value": "#33302C", "$type": "color" },
      "text": { "$value": "#F8F7F4", "$type": "color" },
      "textSecondary": { "$value": "#B5B0A8", "$type": "color" },
      "border": { "$value": "#3D3934", "$type": "color" },
      "accent": { "primary": { "$value": "#E07A5F", "$type": "color" } },
      "focus": { "$value": "#E07A5F", "$type": "color" }
    }
  },
  "typography": {
    "family": {
      "sans": { "$value": "neue-haas-grotesk-text, 'Helvetica Neue', helvetica, arial, sans-serif", "$type": "fontFamily" },
      "display": { "$value": "neue-haas-grotesk-display, 'Helvetica Neue', sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "ibm-plex-mono, 'JetBrains Mono', monospace", "$type": "fontFamily" }
    }
  },
  "radius": {
    "sm": { "$value": "2px", "$type": "dimension" },
    "md": { "$value": "2px", "$type": "dimension" },
    "lg": { "$value": "2px", "$type": "dimension" }
  },
  "density": {
    "comfortable": { "spacingStep": { "$value": "10px", "$type": "dimension" }, "controlHeight": { "$value": "44px", "$type": "dimension" } },
    "compact": { "spacingStep": { "$value": "8px", "$type": "dimension" }, "controlHeight": { "$value": "36px", "$type": "dimension" } }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "160ms", "$type": "duration" },
      "standard": { "$value": "260ms", "$type": "duration" },
      "slow": { "$value": "400ms", "$type": "duration" }
    },
    "easing": { "standard": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)", "$type": "cubicBezier" } }
  }
}
