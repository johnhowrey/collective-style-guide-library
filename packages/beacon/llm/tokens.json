{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Beacon — Schiphol wayfinding tokens. Part of The Collective Style Guide Library.",
  "$version": "0.0.0",
  "color": {
    "light": {
      "background": { "$value": "#FFFFFF", "$type": "color" },
      "surface": { "$value": "#FFFFFF", "$type": "color" },
      "surfaceSecondary": { "$value": "#F5F5F5", "$type": "color" },
      "text": { "$value": "#1B1B1B", "$type": "color", "$extensions": { "collective.contrast": { "vs": "#FFFFFF", "ratio": 16.4, "wcag": "AAA" } } },
      "textSecondary": { "$value": "#5A5A5A", "$type": "color" },
      "border": { "$value": "#1B1B1B", "$type": "color" },
      "accent": {
        "primary": { "$value": "#FFCC00", "$type": "color", "$description": "Schiphol signage yellow" },
        "onPrimary": { "$value": "#000000", "$type": "color", "$description": "Text/icon on yellow surface", "$extensions": { "collective.contrast": { "vs": "#FFCC00", "ratio": 12.6, "wcag": "AAA" } } }
      },
      "focus": { "$value": "#FFCC00", "$type": "color" }
    },
    "dark": {
      "background": { "$value": "#000000", "$type": "color" },
      "surface": { "$value": "#0F0F0F", "$type": "color" },
      "surfaceSecondary": { "$value": "#1B1B1B", "$type": "color" },
      "text": { "$value": "#FFFFFF", "$type": "color" },
      "textSecondary": { "$value": "#A8A8A8", "$type": "color" },
      "border": { "$value": "#FFFFFF", "$type": "color" },
      "accent": {
        "primary": { "$value": "#FFCC00", "$type": "color" },
        "onPrimary": { "$value": "#000000", "$type": "color" }
      },
      "focus": { "$value": "#FFCC00", "$type": "color" }
    }
  },
  "typography": {
    "family": {
      "sans": { "$value": "frutiger, 'Frutiger LT W01', 'Source Sans 3', 'Helvetica Neue', sans-serif", "$type": "fontFamily" },
      "display": { "$value": "frutiger-bold, 'Frutiger LT W01 Bold', 'Source Sans 3', sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "ibm-plex-mono, 'JetBrains Mono', monospace", "$type": "fontFamily" }
    }
  },
  "radius": {
    "sm": { "$value": "0", "$type": "dimension" },
    "md": { "$value": "0", "$type": "dimension" },
    "lg": { "$value": "0", "$type": "dimension" }
  },
  "density": {
    "comfortable": { "spacingStep": { "$value": "8px", "$type": "dimension" }, "controlHeight": { "$value": "44px", "$type": "dimension" } },
    "compact": { "spacingStep": { "$value": "6px", "$type": "dimension" }, "controlHeight": { "$value": "36px", "$type": "dimension" } }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "80ms", "$type": "duration" },
      "standard": { "$value": "140ms", "$type": "duration" },
      "slow": { "$value": "220ms", "$type": "duration" }
    },
    "easing": { "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)", "$type": "cubicBezier" } }
  }
}
