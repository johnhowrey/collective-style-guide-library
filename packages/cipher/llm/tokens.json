{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Cipher — engineering-tool tokens. Part of The Collective Style Guide Library.",
  "$version": "0.0.0",
  "color": {
    "light": {
      "background": { "$value": "#FAFAFA", "$type": "color" },
      "surface": { "$value": "#FFFFFF", "$type": "color" },
      "surfaceSecondary": { "$value": "#F0F0F0", "$type": "color" },
      "text": { "$value": "#1F2328", "$type": "color" },
      "textSecondary": { "$value": "#656D76", "$type": "color" },
      "border": { "$value": "#D1D9E0", "$type": "color" },
      "accent": {
        "primary": { "$value": "#0969DA", "$type": "color" },
        "success": { "$value": "#1A7F37", "$type": "color" },
        "warning": { "$value": "#9A6700", "$type": "color" },
        "danger": { "$value": "#CF222E", "$type": "color" }
      },
      "focus": { "$value": "#0969DA", "$type": "color" }
    },
    "dark": {
      "background": { "$value": "#0D1117", "$type": "color", "$description": "gh-dark canvas" },
      "surface": { "$value": "#161B22", "$type": "color" },
      "surfaceSecondary": { "$value": "#21262D", "$type": "color" },
      "text": { "$value": "#E6EDF3", "$type": "color" },
      "textSecondary": { "$value": "#7D8590", "$type": "color" },
      "border": { "$value": "#30363D", "$type": "color" },
      "accent": {
        "primary": { "$value": "#2F81F7", "$type": "color" },
        "success": { "$value": "#3FB950", "$type": "color" },
        "warning": { "$value": "#D29922", "$type": "color" },
        "danger": { "$value": "#F85149", "$type": "color" }
      },
      "focus": { "$value": "#2F81F7", "$type": "color" }
    }
  },
  "typography": {
    "family": {
      "sans": { "$value": "inter-18pt, 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif", "$type": "fontFamily" },
      "display": { "$value": "inter-28pt, 'Inter Display', 'Inter', system-ui, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "jetbrains-mono, 'JetBrains Mono', 'Fira Code', 'SF Mono', Menlo, monospace", "$type": "fontFamily" }
    }
  },
  "radius": {
    "sm": { "$value": "4px", "$type": "dimension" },
    "md": { "$value": "6px", "$type": "dimension" },
    "lg": { "$value": "8px", "$type": "dimension" }
  },
  "density": {
    "comfortable": { "spacingStep": { "$value": "6px", "$type": "dimension" }, "controlHeight": { "$value": "32px", "$type": "dimension" } },
    "compact": { "spacingStep": { "$value": "4px", "$type": "dimension" }, "controlHeight": { "$value": "26px", "$type": "dimension" } }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "0ms", "$type": "duration" },
      "standard": { "$value": "100ms", "$type": "duration" },
      "slow": { "$value": "180ms", "$type": "duration" }
    },
    "easing": { "standard": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)", "$type": "cubicBezier" } }
  }
}
