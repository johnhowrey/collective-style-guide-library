{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Foundry — Neo Bauhaus tokens. Part of The Collective Style Guide Library.",
  "$version": "0.0.0",
  "color": {
    "light": {
      "background": { "$value": "#FAFAFA", "$type": "color", "$extensions": { "collective.contrast": { "vs": "#0A0A0A", "ratio": 18.4, "wcag": "AAA" } } },
      "surface": { "$value": "#FFFFFF", "$type": "color" },
      "surfaceSecondary": { "$value": "#F0F0F0", "$type": "color" },
      "text": { "$value": "#0A0A0A", "$type": "color", "$extensions": { "collective.contrast": { "vs": "#FAFAFA", "ratio": 18.4, "wcag": "AAA" } } },
      "textSecondary": { "$value": "#4A4A4A", "$type": "color", "$extensions": { "collective.contrast": { "vs": "#FAFAFA", "ratio": 8.9, "wcag": "AAA" } } },
      "border": { "$value": "#1A1A1A", "$type": "color" },
      "accent": {
        "primary": { "$value": "#ED1C24", "$type": "color", "$description": "Bauhaus red" },
        "secondary": { "$value": "#FCD300", "$type": "color", "$description": "Bauhaus yellow" },
        "tertiary": { "$value": "#1A4FAD", "$type": "color", "$description": "Bauhaus blue" }
      },
      "focus": { "$value": "#ED1C24", "$type": "color" }
    },
    "dark": {
      "background": { "$value": "#0A0A0A", "$type": "color", "$extensions": { "collective.contrast": { "vs": "#FAFAFA", "ratio": 18.4, "wcag": "AAA" } } },
      "surface": { "$value": "#1A1A1A", "$type": "color" },
      "surfaceSecondary": { "$value": "#262626", "$type": "color" },
      "text": { "$value": "#FAFAFA", "$type": "color" },
      "textSecondary": { "$value": "#A0A0A0", "$type": "color", "$extensions": { "collective.contrast": { "vs": "#0A0A0A", "ratio": 9.7, "wcag": "AAA" } } },
      "border": { "$value": "#FAFAFA", "$type": "color" },
      "accent": {
        "primary": { "$value": "#FF2A33", "$type": "color" },
        "secondary": { "$value": "#FFE500", "$type": "color" },
        "tertiary": { "$value": "#4D7DD9", "$type": "color" }
      },
      "focus": { "$value": "#FF2A33", "$type": "color" }
    }
  },
  "typography": {
    "family": {
      "sans": { "$value": "futura-pt, futura, 'Helvetica Neue', helvetica, arial, sans-serif", "$type": "fontFamily" },
      "display": { "$value": "futura-pt-bold, futura, 'Helvetica Neue', sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "iosevka, 'JetBrains Mono', 'SF Mono', monospace", "$type": "fontFamily" }
    },
    "weight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight" },
      "heavy": { "$value": 900, "$type": "fontWeight" }
    }
  },
  "radius": {
    "sm": { "$value": "0", "$type": "dimension" },
    "md": { "$value": "0", "$type": "dimension" },
    "lg": { "$value": "0", "$type": "dimension" }
  },
  "density": {
    "comfortable": {
      "spacingStep": { "$value": "8px", "$type": "dimension" },
      "controlHeight": { "$value": "40px", "$type": "dimension" }
    },
    "compact": {
      "spacingStep": { "$value": "6px", "$type": "dimension" },
      "controlHeight": { "$value": "32px", "$type": "dimension" }
    }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "120ms", "$type": "duration" },
      "standard": { "$value": "200ms", "$type": "duration" },
      "slow": { "$value": "320ms", "$type": "duration" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.2, 0, 0.38, 0.9)", "$type": "cubicBezier" }
    }
  },
  "i18n": {
    "rtl": { "$value": true, "$type": "boolean" },
    "recommendedLocales": { "$value": ["en", "de", "fr", "es", "ja", "ar"], "$type": "array" }
  }
}
