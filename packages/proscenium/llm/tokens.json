{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Proscenium — Public Theater-inspired tokens. Part of The Collective Style Guide Library.",
  "$version": "0.0.0",
  "color": {
    "light": {
      "background": { "$value": "#FAF8F0", "$type": "color", "$description": "Playbill cream" },
      "surface": { "$value": "#FFFFFF", "$type": "color" },
      "surfaceSecondary": { "$value": "#F0EBDD", "$type": "color" },
      "text": { "$value": "#0A0A0A", "$type": "color" },
      "textSecondary": { "$value": "#3A3A3A", "$type": "color" },
      "border": { "$value": "#0A0A0A", "$type": "color" },
      "accent": {
        "primary": { "$value": "#FF1F8F", "$type": "color", "$description": "Hot magenta" },
        "secondary": { "$value": "#FFD400", "$type": "color", "$description": "Hot yellow" },
        "onPrimary": { "$value": "#FFFFFF", "$type": "color" }
      },
      "focus": { "$value": "#FF1F8F", "$type": "color" }
    },
    "dark": {
      "background": { "$value": "#0A0A0A", "$type": "color" },
      "surface": { "$value": "#1A1A1A", "$type": "color" },
      "surfaceSecondary": { "$value": "#262626", "$type": "color" },
      "text": { "$value": "#FAFAFA", "$type": "color" },
      "textSecondary": { "$value": "#A0A0A0", "$type": "color" },
      "border": { "$value": "#FAFAFA", "$type": "color" },
      "accent": {
        "primary": { "$value": "#FF3A9F", "$type": "color" },
        "secondary": { "$value": "#FFE500", "$type": "color" },
        "onPrimary": { "$value": "#0A0A0A", "$type": "color" }
      },
      "focus": { "$value": "#FF3A9F", "$type": "color" }
    }
  },
  "typography": {
    "family": {
      "sans": { "$value": "trade-gothic-next-lt-pro, 'Trade Gothic Next', 'Helvetica Neue', helvetica, sans-serif", "$type": "fontFamily" },
      "display": { "$value": "trade-gothic-next-condensed, 'Trade Gothic Next Condensed', 'Helvetica Neue Condensed', sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "ibm-plex-mono, 'JetBrains Mono', monospace", "$type": "fontFamily" }
    }
  },
  "radius": {
    "sm": { "$value": "0", "$type": "dimension" },
    "md": { "$value": "0", "$type": "dimension" },
    "lg": { "$value": "0", "$type": "dimension" }
  },
  "density": {
    "comfortable": { "spacingStep": { "$value": "8px", "$type": "dimension" }, "controlHeight": { "$value": "44px", "$type": "dimension" } },
    "compact": { "spacingStep": { "$value": "6px", "$type": "dimension" }, "controlHeight": { "$value": "36px", "$type": "dimension" } }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "180ms", "$type": "duration" },
      "standard": { "$value": "300ms", "$type": "duration" },
      "slow": { "$value": "560ms", "$type": "duration" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.7, 0, 0.3, 1)", "$type": "cubicBezier", "$description": "Dramatic ease, snap-in/snap-out" }
    }
  }
}
