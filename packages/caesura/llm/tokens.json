{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Caesura — Bringhurst-inspired classical book typography tokens.",
  "$version": "0.0.0",
  "color": {
    "light": {
      "background": { "$value": "#FBF8F2", "$type": "color", "$description": "Refined warm cream" },
      "surface": { "$value": "#FFFFFF", "$type": "color" },
      "surfaceSecondary": { "$value": "#EFEAE0", "$type": "color" },
      "text": { "$value": "#1A1817", "$type": "color", "$extensions": { "collective.contrast": { "vs": "#FBF8F2", "ratio": 15.7, "wcag": "AAA" } } },
      "textSecondary": { "$value": "#5C544C", "$type": "color" },
      "border": { "$value": "#C9C0B0", "$type": "color" },
      "accent": { "primary": { "$value": "#6B1F1F", "$type": "color", "$description": "Oxblood" } },
      "focus": { "$value": "#6B1F1F", "$type": "color" }
    },
    "dark": {
      "background": { "$value": "#1A1817", "$type": "color" },
      "surface": { "$value": "#26221F", "$type": "color" },
      "surfaceSecondary": { "$value": "#33302C", "$type": "color" },
      "text": { "$value": "#FBF8F2", "$type": "color" },
      "textSecondary": { "$value": "#B5AC9F", "$type": "color" },
      "border": { "$value": "#3D3934", "$type": "color" },
      "accent": { "primary": { "$value": "#B85050", "$type": "color" } },
      "focus": { "$value": "#B85050", "$type": "color" }
    }
  },
  "typography": {
    "family": {
      "serif": { "$value": "minion-pro, 'Adobe Caslon Pro', 'Garamond Premier Pro', 'Hoefler Text', Georgia, serif", "$type": "fontFamily", "$description": "Body — Bringhurst-grade old-style serif" },
      "sans": { "$value": "myriad-pro, 'Source Sans 3', 'Helvetica Neue', helvetica, sans-serif", "$type": "fontFamily", "$description": "UI chrome" },
      "display": { "$value": "minion-pro-display, minion-pro, 'Adobe Caslon Pro', serif", "$type": "fontFamily" },
      "mono": { "$value": "ibm-plex-mono, 'JetBrains Mono', monospace", "$type": "fontFamily" }
    }
  },
  "radius": {
    "sm": { "$value": "0", "$type": "dimension" },
    "md": { "$value": "0", "$type": "dimension" },
    "lg": { "$value": "0", "$type": "dimension" }
  },
  "density": {
    "comfortable": { "spacingStep": { "$value": "10px", "$type": "dimension" }, "controlHeight": { "$value": "44px", "$type": "dimension" } },
    "compact": { "spacingStep": { "$value": "8px", "$type": "dimension" }, "controlHeight": { "$value": "36px", "$type": "dimension" } }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "220ms", "$type": "duration" },
      "standard": { "$value": "360ms", "$type": "duration" },
      "slow": { "$value": "540ms", "$type": "duration" }
    },
    "easing": { "standard": { "$value": "cubic-bezier(0.5, 0, 0.4, 1)", "$type": "cubicBezier" } }
  }
}
